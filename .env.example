# Workflows application database (must be separate from n8n's internal database).
DATABASE_URL=postgres://workflows_app:replace-me@localhost:5432/workflows

# Existing self-hosted n8n instance; used by the backend execution adapter.
N8N_BASE_URL=https://n8n.example.com
N8N_API_KEY=replace-me
N8N_MANUAL_WEBHOOK_SECRET=replace-with-a-long-random-secret
