# Dedicated Workflows PostgreSQL database (not n8n's internal database).
# Use a login role that inherits workflows_app. Never expose this value to NEXT_PUBLIC_*.
DATABASE_URL=postgresql://workflows_app_login:replace-me@localhost:5432/workflows
# Set to "require" for hosted PostgreSQL providers that require TLS.
DATABASE_SSL=require

# n8n Public API root, including /api/v1 (API key is server-only).
N8N_API_URL=https://n8n.example.com/api/v1
N8N_API_KEY=replace-me
# Public base URL serving the production /webhook/ path.
N8N_WEBHOOK_BASE_URL=https://n8n.example.com
